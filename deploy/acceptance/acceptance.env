# The module's settings in the acceptance stack. docker-compose.yml, the repository's own, reads them (`--env-file`), so the stack runs the
# production service definition and the way it passes these on. The shell wins over this file: acceptance.sh sets the two public
# addresses from the ports it was given, and checks.py sets MAX_UPLOAD_BYTES when a check needs a small cap.
ENEO_BACKEND_URL=http://eneo:8481
ENEO_PUBLIC_URL=http://127.0.0.1:8481
MODULE_PUBLIC_URL=http://127.0.0.1:8480
MODULE_KEY=speech-to-text
ENEO_API_KEY=acceptance-service-key
SESSION_SECRET=acceptance-session-secret-at-least-32-characters
COOKIE_SECURE=false
# MAX_UPLOAD_BYTES caps the whole request body, multipart overhead included: a benchmark that must complete sets it above the largest
# file's encoded body (the default of 1 GiB is below a 1 GiB file's body, so flat memory there would only show an early rejection).
MAX_UPLOAD_BYTES=3221225472
