{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@astryxdesign/core/locales/*": [
        "./node_modules/@astryxdesign/core/locales/*"
      ],
      "@astryxdesign/core/*": [
        "./node_modules/@astryxdesign/core/dist/*"
      ]
    }
  },
  "files": [
    "node_modules/next/types/global.d.ts"
  ],
  "include": [
    "lib/*.test.ts",
    "tests/next-types.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".test-build"
  ]
}
