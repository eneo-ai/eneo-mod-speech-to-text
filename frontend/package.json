{
  "name": "eneo-mod-speech-to-text-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3002",
    "build": "next build --webpack",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --require ./tests/register.cjs --test .test-build/lib/*.test.js",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "tsc --noEmit",
    "test:a11y": "playwright test",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "theme:build": "npm run astryx -- theme build kit/theme/eneo.theme.ts -o kit/theme/built/eneo.css",
    "dev:stub": "sh -c 'python3 tests/e2e/stub-server.py 8401 & trap \"kill $!\" EXIT; INTERNAL_API_BASE=http://127.0.0.1:8401 next dev -H 127.0.0.1 -p 3401'",
    "state": "playwright test a11y.spec.ts --project=laptop-1440-light --headed -g",
    "test:prod": "playwright test --config playwright.prod.config.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.3",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@stylexjs/stylex": "0.19.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.451.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.3",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/typography": "0.5.15",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.7.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "10.4.20",
    "dom-accessibility-api": "0.7.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
