{
  "name": "eneo-mod-speech-to-text-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3002",
    "build": "next build --webpack",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --require ./tests/register.cjs --test .test-build/lib/*.test.js",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "tsc --noEmit",
    "test:a11y": "playwright test",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "theme:build": "npm run astryx -- theme build kit/theme/eneo.theme.ts -o kit/theme/built/eneo.css",
    "dev:stub": "sh -c 'python3 tests/e2e/stub-server.py ${A11Y_STUB_PORT:-8401} & trap \"kill $!\" EXIT; INTERNAL_API_BASE=http://127.0.0.1:${A11Y_STUB_PORT:-8401} next dev -H 127.0.0.1 -p ${A11Y_APP_PORT:-3401}'",
    "state": "playwright test a11y.spec.ts --project=laptop-1440-light --headed -g",
    "test:a11y:branding": "STUB_BRANDING=custom playwright test --config playwright.branding.config.ts && STUB_BRANDING=name playwright test --config playwright.branding.config.ts",
    "test:a11y:review": "NEXT_PUBLIC_SPEAKER_REVIEW_ENABLED=true playwright test --config playwright.review.config.ts",
    "test:prod": "playwright test --config playwright.prod.config.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.3",
    "@stylexjs/stylex": "0.19.1",
    "lucide-react": "1.49.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.3",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dom-accessibility-api": "0.7.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
