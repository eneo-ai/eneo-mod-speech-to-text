# --- Image ---
# Versionen av ghcr.io/eneo-ai/eneo-mod-speech-to-text som körs: en tagg vX.Y.Z (en uppgradering är att byta den) eller latest,
# den senaste utgåvan. Utgåvorna finns på https://github.com/eneo-ai/eneo-mod-speech-to-text/releases.
MODULE_VERSION=latest

# --- Eneo ---
# Eneo-API som modulens server når. Använd http://backend:8000 när modulen körs på Eneos module_net.
ENEO_BACKEND_URL=https://eneo.example.org
# Publik Eneo-adress dit browsern skickas för att logga in. https krävs; http godtas bara för localhost, 127.0.0.1 och [::1].
ENEO_PUBLIC_URL=https://eneo.example.org
ENEO_API_KEY=sk_replace_me
# Måste matcha Eneos API_KEY_HEADER_NAME. Default: X-API-Key.
ENEO_API_KEY_HEADER_NAME=X-API-Key

# --- Module auth ---
# Modulens adress som browsern når den på. Inloggningen är Eneo SSO och det enda sättet in. https krävs; http godtas
# bara för localhost, 127.0.0.1 och [::1].
MODULE_PUBLIC_URL=https://transkribering.example.org
MODULE_KEY=speech-to-text

# Signerar login-state. Modulsessionen är opak och lagras i backendprocessen.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minst 32 tecken.
SESSION_SECRET=replace-with-long-random-string-now

# Sessionscookien är Secure. false godtas bara när MODULE_PUBLIC_URL är localhost, 127.0.0.1 eller [::1] (lokal
# utveckling); annars stoppas starten.
COOKIE_SECURE=true

# Max tid, i sekunder, som backend får vänta när den skickar en uppladdad fil vidare till Eneo.
# Behövs för stora ljudfiler och långsamt nät. Browsern använder egen progressbaserad timeout.
UPLOAD_PROXY_TIMEOUT_SECONDS=1800

# Största request-body i byte för allt utom uppladdningar, default 10 MiB. En större body får svaret 413.
# MAX_BODY_BYTES=10485760
# Största uppladdade fil i byte, default 1 GiB. Höj den om Eneos flöden tar emot större ljudfiler.
# MAX_UPLOAD_BYTES=1073741824
# Mest som läses av ett enskilt svar från Eneo, i byte, default 32 MiB. Ett längre svar blir 502. En fil som strömmas till browsern räknas inte.
# MAX_RESPONSE_BYTES=33554432

# --- Organisation i sidhuvudet ---
# Utan dessa visas modulens standardorganisation och dess logga. En annan organisation monterar sin logga (SVG eller PNG,
# högst 1 MiB) i backend-tjänsten och anger namnet, som också är loggans alternativtext:
# ORGANIZATION_NAME=Umeå kommun
# ORGANIZATION_LOGO=/branding/logo.svg
# ORGANIZATION_LOGO_DARK=/branding/logo-mork.svg
# Bara "Tal till text", ingen organisation:
# SHOW_ORGANIZATION=false
# Organisationens accentfärg (#RRGGBB): knappar, länkar, fokusramar, valda rader. Utan den gäller modulens blå.
# Mörkt läge härleds ur den ljusa; en egen mörk färg anges med ORGANIZATION_ACCENT_DARK. En färg som inte
# är läsbar (4,5:1 mot sidans ytor) stoppar starten med ett felmeddelande. Se docs/branding.md.
# ORGANIZATION_ACCENT=#1E7B34
# ORGANIZATION_ACCENT_DARK=#2AAE4A

# Transcript editor and speaker-review controls. A build argument, not a run-time setting: it is fixed when the image is
# built (`docker compose build`, which docker-compose.override.yml makes a local build, or `docker build --build-arg
# SPEAKER_REVIEW_ENABLED=true`), and a published image has it off: setting it for a published image does nothing.
# Speaker writes require Eneo v3 support; this does not opt Eneo into Vemsa review.
SPEAKER_REVIEW_ENABLED=false

# --- Traefik (valfritt tillägg, docker-compose.traefik.yml) ---
# För en värd utan egen omvänd proxy: Traefik med HTTPS från Let's Encrypt framför modulen. MODULE_HOST är modulens värdnamn (MODULE_PUBLIC_URL är
# https://<det>) och ACME_EMAIL får Let's Encrypts meddelanden om certifikatet. Port 80 och 443 ska nå värden från internet. Dokploy har sin egen Traefik.
MODULE_HOST=transkribering.example.org
ACME_EMAIL=drift@example.org
# Proxyns läsgräns för en hel request, uppladdningen inräknad. Standard 1800s räcker för 1 GiB över 5 Mbit/s; räkna om den om MAX_UPLOAD_BYTES eller den
# långsammaste uppkopplingen ändras (docs/operations.md).
# PROXY_READ_TIMEOUT=1800s
# Let's Encrypts teststeg i stället för det skarpa, medan uppsättningen provas (det skarpa har en gräns för misslyckade försök):
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
