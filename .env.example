# --- Eneo ---
# Eneo-API för lokal/fristående Compose. Använd http://backend:8000 endast när
# produktionsimagen körs på Eneos module_net (inte i denna tvåservice-Compose,
# där namnet backend tillhör modulens egen FastAPI-tjänst).
ENEO_BACKEND_URL=https://flow.sundsvall.dev
# Publik Eneo-adress dit browsern skickas för login i eneo_sso-läge.
ENEO_PUBLIC_URL=https://flow.sundsvall.dev
ENEO_API_KEY=sk_replace_me
# Måste matcha Eneos API_KEY_HEADER_NAME. Default: X-API-Key.
ENEO_API_KEY_HEADER_NAME=X-API-Key

# --- Module auth ---
MODULE_PUBLIC_URL=https://transkribering.sundsvall.dev
MODULE_KEY=speech-to-text

# Standard och permanent läge: Eneo SSO.
AUTH_MODE=eneo_sso
# Tillfälligt testläge: byt raden ovan till access_code och sätt en hemlig kod
# (16–256 tecken) i Dokploy. Lägg aldrig en riktig kod i denna fil.
# Generera exempelvis med: python -c "import secrets; print(secrets.token_urlsafe(24))"
# APP_ACCESS_CODE=replace-with-random-test-code

# Signerar login-state. Modulsessionen är opak och lagras i backendprocessen.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minst 32 tecken.
SESSION_SECRET=replace-with-long-random-string-now

# Sätt till true bakom HTTPS (produktion). Sätt false för lokal http://localhost.
COOKIE_SECURE=true

# Max tid, i sekunder, som backend får vänta när den skickar en uppladdad fil vidare till Eneo.
# Behövs för stora ljudfiler och långsamt nät. Browsern använder egen progressbaserad timeout.
UPLOAD_PROXY_TIMEOUT_SECONDS=1800

# --- Hardcoded space (valfritt) ---
# Om satt: skippar space-väljaren i UI och listar bara flöden i detta space.
DEMO_SPACE_ID=
DEMO_SPACE_NAME=
