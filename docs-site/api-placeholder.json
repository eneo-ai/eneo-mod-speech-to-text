{
  "openapi": "3.1.0",
  "info": {
    "title": "Tal till text, API",
    "version": "platshållare",
    "description": "Platshållare tills den genererade filen docs/api/openapi.json finns. Sidan läser den filen så snart den ligger i repot."
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Modulen"],
        "summary": "Hälsokontroll",
        "responses": {
          "200": {
            "description": "Modulen svarar.",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } }, "example": { "ok": true } } }
          }
        }
      }
    },
    "/api/auth/status": {
      "get": {
        "tags": ["Inloggning"],
        "summary": "Inloggningens status",
        "responses": {
          "200": { "description": "Om besökaren är inloggad, och hur länge inloggningen gäller." }
        }
      }
    },
    "/api/eneo/flows/": {
      "get": {
        "tags": ["Anrop till Eneo"],
        "summary": "Lista flöden",
        "description": "Ett av de anrop till Eneo som modulen släpper igenom.",
        "responses": {
          "200": { "description": "Eneos svar, oförändrat." },
          "401": { "description": "Ingen giltig modulsession." }
        }
      }
    }
  }
}
