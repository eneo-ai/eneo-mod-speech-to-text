{
  "name": "eneo-mod-speech-to-text-docs",
  "private": true,
  "type": "module",
  "description": "The documentation site (Astro Starlight), built from ../docs. Separate from the module and its image.",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "node scripts/prepare-content.mjs && astro dev --host 127.0.0.1",
    "build": "node scripts/prepare-content.mjs && astro build --force && node scripts/check-built.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "astro preview --host 127.0.0.1",
    "check": "node check.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.5",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "astro": "7.3.5",
    "mermaid": "12.1.0",
    "parse5": "7.3.0",
    "starlight-openapi": "0.26.3",
    "starlight-theme-md3": "0.2.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "form-data": "4.0.6",
    "vitefu": {
      "vite": "8.3.2"
    }
  }
}
